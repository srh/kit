// for kEI_NIDENT
import linux_objfile;

import objfile;

// This is identical to elf32_Header except for the le_u64 offsets.
struct elf64_Header {
  // TODO: Move constant 16 to a def kEI_NIDENT (when the language supports it).
  e_ident ^[16]u8;
  // Type: Relocatable, executable, etc.
  e_type le_u16;
  // Machine: 386, amd64, etc.
  e_machine le_u16;
  // Version: Should be EV_CURRENT.
  e_version le_u32;
  // Entry point (for executables).
  e_entry le_u64;
  // Program header offset, zero for .o files.
  e_phoff le_u64;
  // Section header offset.
  e_shoff le_u64;
  // Flags, none defined.  (Zero.)
  e_flags le_u32;
  // Size of this elf header.
  e_ehsize le_u16;
  // Size of a program header entry.  (Zero for .o files?)
  e_phentsize le_u16;
  // Number of program header entries.  (Zero for .o files.)
  e_phnum le_u16;
  // Size of a section header entry.
  e_shentsize le_u16;
  // Number of section headers.
  e_shnum le_u16;
  // Section header table index of the entry associated with the section name string table.  Or SHN_UNDEF, if the file has no section name string table.  Must be less than SHN_LORESERVE (0xff00), otherwise the value is stored elsewhere.
  e_shstrndx le_u16;
}

// Identical to elf32_Section_Header except for the le_u64 constants.
struct elf64_Section_Header {
  // An index into the section header string table section.
  sh_name le_u32;
  /* SHT_PROGBITS for "information defined by the program", SHT_SYMTAB
  for a symbol table, SHT_STRTAB for a string table, SHT_RELA for
  "relocation entries with explicit addends", SHT_REL for "relocation
  offsets without explicit addends", SHT_NOBITS for .bss section. */
  sh_type le_u32;
  /* flags: SHF_WRITE: data that should be writable during process
  execution.  SHF_ALLOC: This secton occupies memory during process
  execution.  SHF_EXECINSTR: This section contains executable machine
  instructions. */
  sh_flags le_u64;
  /* The address at which the section's first byte should reside?  So,
  zero for .o files? */
  sh_addr le_u64;
  // File offset of the section.
  sh_offset le_u64;
  // Section's size in bytes.
  sh_size le_u64;
  // A "section header table index link."
  sh_link le_u32;
  // Extra info.
  sh_info le_u32;
  // Section alignment constraint.  0 means the same as 1.
  sh_addralign le_u64;
  /* For sections that hold a table of fixed-size entries: The size in
  bytes for each entry. */
  sh_entsize le_u64;
}

// Fields of elf32_Symtab_Entry but in a different order, and some are le_u64.
struct elf64_Symtab_Entry {
  st_name le_u32;
  st_info u8;
  st_other u8;
  st_shndx le_u16;
  st_value le_u64;
  st_size le_u64;
}

// elf32_Rel is used for 32-bit, but we use elf64_Rela with the addend.
struct elf64_Rela {
  r_offset le_u64;
  r_info le_u64;
  r_addend le_i64;
}

// These are mostly def'd to be u32's because I don't know what to define them as.
// True in linux_objfile.ki and here to be consistent.

/* Seems like a good idea. */
def kRela_Section_Alignment u32 = 8;

def kELFCLASS64 u8 = 2;
def kEM_X86_64 u32 = 3;
def kSHT_RELA u32 = 4;
def kLinux64DataSectionNumber u32 = 5;
def kLinux64RodataSectionNumber u32 = 7;
def kLinux64TextSectionNumber u32 = 9;
def kLinux64NoteGnuStackSectionNumber u32 = 11;
def kR_X86_64_32 u32 = 10;
def kR_X86_64_PC32 u32 = 2;

func linux64_flatten(im *identmap, f *objfile) array[u8] {
  d array[u8];
  section_header_offset u64 = ~sizeof@[elf64_Header];
  kNumSectionHeaders u64 = 11;
  end_of_section_headers u64 = section_header_offset + kNumSectionHeaders * ~sizeof@[elf64_Section_Header];
  sh_strtab_offset u64 = end_of_section_headers;

  // Note the names have ".rela.", not the ".rel." used in i386.
  sh_strtab array[u8];
  ign u32 = strtab_add(&sh_strtab, _u8(""));
  dot_shstrtab_index u32 = strtab_add(&sh_strtab, _u8(".shstrtab"));
  dot_strtab_index u32 = strtab_add(&sh_strtab, _u8(".strtab"));
  dot_symtab_index u32 = strtab_add(&sh_strtab, _u8(".symtab"));
  dot_rela_data_index u32 = strtab_add(&sh_strtab, _u8(".rela.data"));
  dot_data_index u32 = strtab_add(&sh_strtab, _u8(".data"));
  dot_rela_rodata_index u32 = strtab_add(&sh_strtab, _u8(".rela.rodata"));
  dot_rodata_index u32 = strtab_add(&sh_strtab, _u8(".rodata"));
  dot_rela_text_index u32 = strtab_add(&sh_strtab, _u8(".rela.text"));
  dot_text_index u32 = strtab_add(&sh_strtab, _u8(".text"));
  dot_note_gnu_stack_index u32 = strtab_add(&sh_strtab, _u8(".note.GNU-stack"));
  ign = strtab_add(&sh_strtab, _u8(""));

  sym_strtab_offset u64 = sh_strtab_offset + ~count(&sh_strtab);

  symbols array[u8];
  strings array[u8];
  sti_map array[u32];
  end_local_symbols u32;
  linux64_write_symbols_and_strings(im, f, &symbols, &strings, &sti_map, &end_local_symbols);

  sym_strtab_size u64 = ~count(&strings);
  sym_strtab_end u64 = sym_strtab_offset + sym_strtab_size;

  // I don't know, align it to 16 (that's its entry size).
  kSymtabAlignment u64 = 16;
  symtab_offset u64 = ceil_aligned(sym_strtab_end, kSymtabAlignment);
  symtab_size u64 = ~count(&symbols);
  symtab_end u64 = symtab_offset + symtab_size;

  sh_rela_data elf64_Section_Header;
  sh_data elf64_Section_Header;
  data_end u64;
  linux64_section_headers(symtab_end, kLinux64DataSectionNumber, &f->data, dot_rela_data_index, dot_data_index, kSHF_WRITE, &sh_rela_data, &sh_data, &data_end);

  sh_rela_rodata elf64_Section_Header;
  sh_rodata elf64_Section_Header;
  rodata_end u64;
  linux64_section_headers(data_end, kLinux64RodataSectionNumber, &f->rdata, dot_rela_rodata_index, dot_rodata_index, 0, &sh_rela_rodata, &sh_rodata, &rodata_end);

  sh_rela_text elf64_Section_Header;
  sh_text elf64_Section_Header;
  text_end u64;
  linux64_section_headers(rodata_end, kLinux64TextSectionNumber, &f->text, dot_rela_text_index, dot_text_index, kSHF_EXEC, &sh_rela_text, &sh_text, &text_end);

  note_gnustack_offset u64 = text_end;

  if true {
    h elf64_Header;
    h.e_ident[0] = 0x7f;
    h.e_ident[1] = 'E';
    h.e_ident[2] = 'L';
    h.e_ident[3] = 'F';
    h.e_ident[4] = kELFCLASS64;  // linux32 uses kELFCLASS32
    h.e_ident[5] = kELFDATA2LSB;
    h.e_ident[6] = ~kEV_CURRENT;
    h.e_ident[7] = 0;  // kELFOSABI_LINUX;
    h.e_ident[8] = 0;  // EI_ABIVERSION (= 8): must use zero.
    // padding
    n_kEI_NIDENT size = ~kEI_NIDENT;
    for i size = 9; i < n_kEI_NIDENT; i = i + 1 {
      h.e_ident[i] = 0;
    }

    h.e_type = ~ @[u16] ~kET_REL;
    h.e_machine = ~ @[u16] ~kEM_X86_64;  // linux32 uses kEM_386
    h.e_version = ~ kEV_CURRENT;
    h.e_entry = ~ @[u64] 0;
    h.e_phoff = ~ @[u64] 0;
    h.e_shoff = ~ section_header_offset;
    h.e_flags = ~ @[u32] 0;
    h.e_ehsize = ~ @[u16] ~ sizeof@[elf64_Header];
    h.e_phentsize = ~ @[u16] ~ @[u32] 0;
    h.e_phnum = ~ @[u16] ~ @[u32] 0;
    h.e_shentsize = ~ @[u16] ~ sizeof@[elf64_Section_Header];
    h.e_shnum = ~ @[u16] ~kNumSectionHeaders;
    // String table section header is at index 1.
    h.e_shstrndx = ~ @[u16] ~ @[u32] 1;

    append_reinterpret(&d, &h);
  }

  if true {
    // Null section header (for index 0).
    sh elf64_Section_Header;
    sh.sh_name = ~ @[u32] 0;
    sh.sh_type = ~kSHT_NULL;
    sh.sh_flags = ~ @[u64] 0;
    sh.sh_addr = ~ @[u64] 0;
    sh.sh_offset = ~ @[u64] 0;
    sh.sh_size = ~ @[u64] 0;
    sh.sh_link = ~ @[u32] 0;
    sh.sh_info = ~ @[u32] 0;
    sh.sh_addralign = ~ @[u64] 0;
    sh.sh_entsize = ~ @[u64] 0;
    append_reinterpret(&d, &sh);
  }

  if true {
    // Strings table section header -- index 1.
    sh elf64_Section_Header;
    sh.sh_name = ~dot_shstrtab_index;
    sh.sh_type = ~kSHT_STRTAB;
    sh.sh_flags = ~ @[u64] 0;
    sh.sh_addr = ~ @[u64] 0;
    sh.sh_offset = ~sh_strtab_offset;
    sh.sh_size = ~ @[u64] ~count(&sh_strtab);
    sh.sh_link = ~ @[u32] 0;
    sh.sh_info = ~ @[u32] 0;
    sh.sh_addralign = ~ @[u64] 0;
    sh.sh_entsize = ~ @[u64] 0;
    append_reinterpret(&d, &sh);
  }

  if true {
    // Symbol table strings section header -- index 2.
    sh elf64_Section_Header;
    sh.sh_name = ~dot_strtab_index;
    sh.sh_type = ~kSHT_STRTAB;
    sh.sh_flags = ~ @[u64] 0;
    sh.sh_addr = ~ @[u64] 0;
    sh.sh_offset = ~sym_strtab_offset;
    sh.sh_size = ~sym_strtab_size;
    sh.sh_link = ~ @[u32] 0;
    sh.sh_info = ~ @[u32] 0;
    sh.sh_addralign = ~ @[u64] 0;
    sh.sh_entsize = ~ @[u64] 0;
    append_reinterpret(&d, &sh);
  }

  if true {
    check(kSymTabSectionNumber == 3);
    // Symbol table section header -- index 3.
    sh elf64_Section_Header;
    sh.sh_name = ~dot_symtab_index;
    sh.sh_type = ~kSHT_SYMTAB;
    sh.sh_flags = ~ @[u64] 0;
    sh.sh_addr = ~ @[u64] 0;
    sh.sh_offset = ~symtab_offset;
    sh.sh_size = ~symtab_size;
    // The associated string table's section header index.
    sh.sh_link = ~ @[u32] 2;
    sh.sh_info = ~end_local_symbols;
    sh.sh_addralign = ~ @[u64] 0;
    sh.sh_entsize = ~ @[u64] ~sizeof@[elf64_Symtab_Entry];
    append_reinterpret(&d, &sh);
  }

  check(kLinux64DataSectionNumber == 5);
  append_reinterpret(&d, &sh_rela_data);
  append_reinterpret(&d, &sh_data);
  check(kLinux64RodataSectionNumber == 7);
  append_reinterpret(&d, &sh_rela_rodata);
  append_reinterpret(&d, &sh_rodata);
  check(kLinux64TextSectionNumber == 9);
  append_reinterpret(&d, &sh_rela_text);
  append_reinterpret(&d, &sh_text);

  if true {
    check(kLinux32NoteGnuStackSectionNumber == 11);
    // .note.GNU-stack section header -- index 11.
    sh elf64_Section_Header;
    sh.sh_name = ~dot_note_gnu_stack_index;
    sh.sh_type = ~kSHT_PROGBITS;
    // sh_flags being set to zero, without kSHF_EXEC, is the purpose of this header.
    sh.sh_flags = ~ @[u64] 0;
    sh.sh_addr = ~ @[u64] 0;
    sh.sh_offset = ~note_gnustack_offset;
    sh.sh_size = ~ @[u64] 0;
    sh.sh_link = ~ @[u32] 0;
    sh.sh_info = ~ @[u32] 0;
    sh.sh_addralign = ~ @[u64] 0;
    sh.sh_entsize = ~ @[u64] 0;
    append_reinterpret(&d, &sh);
  }

  // Section headers done -- append string table.
  check(~count(&d) == sh_strtab_offset);
  append(&d, &sh_strtab);

  check(~count(&d) == sym_strtab_offset);
  append(&d, &strings);
  check(~count(&d) == sym_strtab_end);

  append_to_alignment(&d, ~kSymtabAlignment, 0);
  check(~count(&d) == symtab_offset);
  append(&d, &symbols);
  check(~count(&d) == symtab_end);

  append_to_alignment(&d, ~kRel_Section_Alignment, 0);
  check(~count(&d) == ~sh_rela_data.sh_offset);
  linux64_append_relocations(&sti_map, &d, &f->data);
  append_to_alignment(&d, ~f->data.max_requested_alignment, 0);
  check(~count(&d) == ~sh_data.sh_offset);
  append(&d, &f->data.raw);

  append_to_alignment(&d, ~kRel_Section_Alignment, 0);
  check(~count(&d) == ~sh_rela_rodata.sh_offset);
  linux64_append_relocations(&sti_map, &d, &f->rdata);
  append_to_alignment(&d, ~f->rdata.max_requested_alignment, 0);
  check(~count(&d) == ~sh_rodata.sh_offset);
  append(&d, &f->rdata.raw);

  append_to_alignment(&d, ~kRel_Section_Alignment, 0);
  check(~count(&d) == ~sh_rela_text.sh_offset);
  linux64_append_relocations(&sti_map, &d, &f->text);
  append_to_alignment(&d, ~f->text.max_requested_alignment, 0);
  check(~count(&d) == ~sh_text.sh_offset);
  append(&d, &f->text.raw);
  check(~count(&d) == note_gnustack_offset);

  return d;
}

func linux64_append_relocations(sti_map *array[u32], d *array[u8], s *objfile_section) void {
  nrelocs size = count(&s->relocs);
  for i size = 0; i < nrelocs; i = i + 1 {
    reloc *objfile_relocation = ref(&s->relocs, i);
    rel elf64_Rela;
    // TODO: Maybe reloc->virtual_address should be u64.
    virtual_address u32 = reloc->virtual_address;
    rel.r_offset = ~ @[u64] ~virtual_address;
    sti u32 = reloc->symbol_table_index.x;
    new_sti u32 = get(sti_map, ~sti);
    rel_type u32;
    addend_le le_i64;
    switch reloc->type {
    case Dir32:
      rel_type = kR_X86_64_32;
      addend_le = ~ @[i64] 0;
    case Rel32:
      rel_type = kR_X86_64_PC32;
      addend_le = ~ - @[i64] 4;  // (There's a negative sign!)
    case Diff32:
      crash(_u8("linux sees Diff32 reloc"));
    }
    rel.r_info = ~(((@[u64] ~new_sti) << 32) | (@[u64] ~rel_type));
    rel.r_addend = addend_le;
    append_reinterpret(d, &rel);
  }
}

func linux64_section_headers(prev_end_offset u64, sh_out_index u32, s *objfile_section, sh_strtab_rela_index u32, sh_strtab_index u32, sh_flags u32, rel_out *elf64_Section_Header, sh_out *elf64_Section_Header, end_out *u64) void {
  rel_offset u64 = ceil_aligned(prev_end_offset, ~kRela_Section_Alignment);
  rel_size u64 = ~(count(&s->relocs) * sizeof@[elf64_Rela]);
  rel_end u64 = rel_offset + rel_size;
  sh_alignment u64 = ~s->max_requested_alignment;
  sh_offset u64 = ceil_aligned(rel_end, sh_alignment);
  sh_size u64 = ~count(&s->raw);
  sh_end u64 = sh_offset + sh_size;

  rel_out->sh_name = ~sh_strtab_rela_index;
  rel_out->sh_type = ~kSHT_REL;
  rel_out->sh_flags = ~ @[u64] 0;
  rel_out->sh_addr = ~ @[u64] 0;
  rel_out->sh_offset = ~rel_offset;
  rel_out->sh_size = ~rel_size;
  rel_out->sh_link = ~kSymTabSectionNumber;
  rel_out->sh_info = ~sh_out_index;
  rel_out->sh_addralign = ~ @[u64] 0;
  rel_out->sh_entsize = ~ @[u64] ~sizeof@[elf64_Rela];

  sh_out->sh_name = ~sh_strtab_index;
  sh_out->sh_type = ~kSHT_PROGBITS;
  sh_out->sh_flags = ~ @[u64] ~(kSHF_ALLOC | sh_flags);
  sh_out->sh_addr = ~ @[u64] 0;
  sh_out->sh_offset = ~sh_offset;
  sh_out->sh_size = ~sh_size;
  sh_out->sh_link = ~kSHN_UNDEF;
  sh_out->sh_info = ~ @[u32] 0;
  sh_out->sh_addralign = ~sh_alignment;
  sh_out->sh_entsize = ~ @[u64] 0;

  *end_out = sh_end;
}

func linux64_write_symbols_and_strings(im *identmap, f *objfile, symbols_out *array[u8], strings_out *array[u8], sti_map_out *array[u32], end_locals_out *u32) void {
  symbols array[u8];
  symbols_count u32 = 0;
  strings array[u8];
  ign var = strtab_add(&strings, _u8(""));

  // Maps from f->symbol_table's indexes to symbols indexes, because they get reordered (and index zero cannot be used).
  sti_map array[u32] = repeat(count(&f->symbol_table), @[u32] 0);

  if true {
    ent elf64_Symtab_Entry;
    ent.st_name = ~ @[u32] 0;
    ent.st_value = ~ @[u64] 0;
    ent.st_size = ~ @[u64] 0;
    ent.st_info = 0;
    ent.st_other = 0;
    ent.st_shndx = ~ @[u16] ~ kSHN_UNDEF;
    append_reinterpret(&symbols, &ent);
    symbols_count = symbols_count + 1;
  }

  n_symbol_table size = count(&f->symbol_table);
  for i size = 0; i < n_symbol_table; i = i + 1 {
    rec *objfile_symbol_record = ref(&f->symbol_table, i);
    if case IsStaticYes = rec->is_static {
      linux64_push_symbol(im, rec, &symbols, &strings);
      *ref(&sti_map, i) = symbols_count;
      symbols_count = symbols_count + 1;
    }
  }

  end_locals u32 = symbols_count;

  for i size = 0; i < n_symbol_table; i = i + 1 {
    rec *objfile_symbol_record = ref(&f->symbol_table, i);
    if case IsStaticNo = rec->is_static {
      linux64_push_symbol(im, rec, &symbols, &strings);
      *ref(&sti_map, i) = symbols_count;
      symbols_count = symbols_count + 1;
    }
  }

  ign = strtab_add(&strings, _u8(""));

  *symbols_out = symbols;
  *strings_out = strings;
  *sti_map_out = sti_map;
  *end_locals_out = end_locals;
}

func linux64_push_symbol(im *identmap, symbol *objfile_symbol_record, symbols *array[u8], strings *array[u8]) void {
  // TODO: (Also in s1:) This and the for loop below is just a copy/paste job.
  ent elf64_Symtab_Entry;
  name sym = symbol->name;
  name_buf string = lookup(im, name);

  offset u32 = strtab_add(strings, zeroless_string_to_u8symbol(&name_buf));
  ent.st_name = ~offset;
  ent.st_value = ~ @[u64] ~symbol->value;
  // TODO: (Also in s1:) It's OK to just use zero for everything?
  ent.st_size = ~ @[u64] 0;
  st_info u8;
  if case IsFunctionYes = symbol->is_function {
    st_info = ~kSTT_FUNC;
  } else {
    st_info = ~kSTT_OBJECT;
  }
  if case IsStaticYes = symbol->is_static {
    st_info = st_info | ~(kSTB_LOCAL << 4);
  } else {
    st_info = st_info | ~(kSTB_GLOBAL << 4);
  }
  ent.st_info = st_info;
  ent.st_other = 0;

  switch symbol->section {
  case SymbolSectionUndefined: ent.st_shndx = ~ @[u16] ~kSHN_UNDEF;
  case SymbolSectionData: ent.st_shndx = ~ @[u16] ~kLinux64DataSectionNumber;
  case SymbolSectionRdata: ent.st_shndx = ~ @[u16] ~kLinux64RodataSectionNumber;
  case SymbolSectionText: ent.st_shndx = ~ @[u16] ~kLinux64TextSectionNumber;
  }

  append_reinterpret(symbols, &ent);
}
